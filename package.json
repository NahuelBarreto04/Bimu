  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "test": "node --test tests/notch-hover.test.mjs tests/weather.test.mjs tests/lyrics.test.mjs tests/dock-geometry.test.mjs tests/ollama-client.test.mjs tests/conversation-store.test.mjs tests/voice-audio.test.mjs tests/application-intent.test.mjs tests/wake.test.mjs tests/chat-submit.test.mjs tests/preferences.test.mjs tests/assistant.test.mjs tests/home-avatar.test.mjs tests/autonomy.test.mjs",
    "voice:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-voice.ps1",
    "voice:setup:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-voice.ps1 -Mode gpu",
    "voice:start:gpu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-voice.ps1 -Mode gpu",
    "voice:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-voice.ps1",
    "test:native": "cargo test --manifest-path native-tests/Cargo.toml"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.7",
